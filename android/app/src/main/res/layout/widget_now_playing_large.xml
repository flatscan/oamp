<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, wide and two or more cells high: a big cover on the
     left, and the title, artist and larger buttons beside it. Same ids as
     widget_now_playing.xml; NowPlayingWidget.kt sizes the cover, text and
     buttons to fit the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/widget_art_background"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_no_art"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_idle_title"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_previous"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/widget_play_background"
                android:contentDescription="@string/widget_play"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
