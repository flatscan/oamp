<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, roughly square and two or more cells high: the
     cover fills it, with the title and buttons along the bottom. Same ids as
     widget_now_playing.xml, filled in and sized by NowPlayingWidget.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_no_art"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_title"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/widget_play_background"
                android:contentDescription="@string/widget_play"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
